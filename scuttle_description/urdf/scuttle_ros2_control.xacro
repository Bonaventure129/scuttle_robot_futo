<?xml version="1.0"?>
<robot name="scuttle" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="is_sim" default="true" />
    <xacro:arg name="is_ignition" default="false" />

    <ros2_control name="RobotSystem" type="system">

        <xacro:if value="$(arg is_sim)">
            
            <xacro:if value="$(arg is_ignition)">
                <hardware>
                    <plugin>ign_ros2_control/IgnitionSystem</plugin>
                </hardware>
            </xacro:if>

            <xacro:unless value="$(arg is_ignition)">
                <hardware>
                    <plugin>gz_ros2_control/GazeboSimSystem</plugin>
                </hardware>
            </xacro:unless>
        </xacro:if>

        <xacro:unless value="$(arg is_sim)">
            <hardware>
                <plugin>scuttle_firmware/ScuttleInterface</plugin>
                <param name="port">/dev/ttySA</param>
            </hardware>
        </xacro:unless>
        
        <joint name="r_wheel_joint">
            <command_interface name="velocity">
              <param name="min">-5</param>
              <param name="max">5</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="l_wheel_joint">
            <command_interface name="velocity">
              <param name="min">-5</param>
              <param name="max">5</param>
            </command_interface>
            <state_interface name="position" />
            <state_interface name="velocity" />
        </joint>

        <joint name="l_caster_swivel_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="l_caster_wheel_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="r_caster_swivel_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        <joint name="r_caster_wheel_joint">
            <state_interface name="position"/>
            <state_interface name="velocity"/>
        </joint>
        
    </ros2_control>

</robot>